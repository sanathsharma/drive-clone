{
	"name": "drive-clone",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "secretspec run -- next build",
		"build-storybook": "storybook build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "secretspec run -- drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"dev": "secretspec run -- next dev -p 4040",
		"lint": "eslint --fix & biome check --write & npm run stylelint & npm run typecheck",
		"start": "secretspec run -- next start -p 4040",
		"storybook": "storybook dev -p 6006",
		"stylelint": "stylelint --fix --config stylelint.config.mjs '**/*.css'",
		"test": "vitest",
		"test-storybook": "vitest --project=storybook",
		"test:docker": "docker compose run --rm --build test",
		"test:docker:watch": "docker compose run --rm --build test-watch",
		"typecheck": "tsc --noEmit",
		"update-outdated": "bun update"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"@neondatabase/auth": "0.5.0-beta",
		"@neondatabase/serverless": "1.1.0",
		"@tanstack/react-query": "5.102.8",
		"@xstate/react": "6.1.0",
		"arktype": "2.2.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cn": "0.2.3",
		"drizzle-orm": "0.45.2",
		"jose": "6.2.10",
		"loglevel": "1.9.2",
		"loglevel-plugin-prefix": "0.8.4",
		"lucide-react": "1.39.0",
		"next": "16.3.4",
		"next-intl": "4.14.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-dropzone": "^20.1.1",
		"shadcn": "4.19.1",
		"tailwind-merge": "3.6.0",
		"tw-animate-css": "1.4.0",
		"xstate": "5.32.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@chromatic-com/storybook": "5.3.0",
		"@github-ui/storybook-addon-performance-panel": "1.2.0",
		"@storybook/addon-a11y": "10.5.10",
		"@storybook/addon-docs": "10.5.10",
		"@storybook/addon-mcp": "0.7.0",
		"@storybook/addon-vitest": "10.5.10",
		"@storybook/nextjs-vite": "10.5.10",
		"@tailwindcss/postcss": "4.3.3",
		"@tanstack/eslint-plugin-query": "5.102.8",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/browser-playwright": "4.1.11",
		"@vitest/coverage-v8": "4.1.11",
		"babel-plugin-react-compiler": "1.0.0",
		"drizzle-kit": "0.31.10",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.4",
		"eslint-plugin-storybook": "10.5.10",
		"jsdom": "30.0.1",
		"playwright": "1.62.1",
		"storybook": "10.5.10",
		"stylelint": "17.14.1",
		"stylelint-config-recess-order": "7.8.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-config-tailwindcss": "1.0.1",
		"stylelint-order": "8.1.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	},
	"packageManager": "bun@1.3.14",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"browserslist": [
		">0.5%"
	]
}